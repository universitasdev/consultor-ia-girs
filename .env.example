# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key"

# Backend URL
BACKEND_URL="http://localhost:3001" # O la URL de tu API en producción

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Gateway AI GIRS (Cloud Run) — incluir el path /api/chat
# Configurar el valor real solo en .env local o en secrets del deploy (no en el repo)
AI_GATEWAY_URL="https://TU-GATEWAY.run.app/api/chat"

# Email Configuration (for Nodemailer)
RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="app@universitas.legal"
